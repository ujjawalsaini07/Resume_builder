# Port the Express server listens on
PORT=3000

# MongoDB connection string (without a trailing slash / db name - the app appends "/resume-builder")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Secret used to sign/verify JWTs
JWT_SECRET=replace_with_a_long_random_string

# Gemini API key (either name works - GEMINI_API_KEY takes priority)
GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_API_KEY=your_gemini_api_key

# Gemini model to use (defaults to gemini-3.6-flash if not set)
GEMINI_MODEL=gemini-3.6-flash

# Optional: comma-separated list of fallback models to retry if the primary model
# is rate-limited/unavailable (defaults to gemini-flash-latest,gemini-3.5-flash,gemini-3.1-flash-lite)
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-3.1-flash-lite

# ImageKit private key, used for profile image uploads
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
