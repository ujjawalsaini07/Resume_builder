# Port the Express server listens on
PORT=3000

# MongoDB connection string (without a trailing slash / db name - the app appends "/resume-builder")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Secret used to sign/verify JWTs
JWT_SECRET=replace_with_a_long_random_string

# Gemini API key (either name works - GEMINI_API_KEY takes priority)
GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_API_KEY=your_gemini_api_key

# Optional: override the default Gemini model / fallback models
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash-lite

# ImageKit private key, used for profile image uploads
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
